#!/usr/bin/env bash
# Load the skill that covers a file before it is edited.
#
# Claude Code only auto-loads skill names and descriptions, not their bodies, so
# invoking the right one is left to the model's judgement -- which is how gsx
# markup or hk config gets hand-invented. This makes it the harness's job.
#
# Reads a PreToolUse payload on stdin; prints additionalContext when the file
# maps to a skill, nothing otherwise. Every skill it can serve lives in
# .claude/skills, so adding one is a line in the case below.
set -euo pipefail

payload=$(cat)
path=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty')
[ -n "$path" ] || exit 0

case "$path" in
  *.gsx)  skill=gsx ;;
  *.pkl)  skill=hk-configure ;;
  *)      exit 0 ;;
esac

body=".claude/skills/$skill/SKILL.md"
[ -f "$body" ] || exit 0

jq -n --arg s "$skill" --rawfile b "$body" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    additionalContext: ("The \($s) skill covers this file. Follow it rather than "
      + "inferring syntax:\n\n" + $b)
  }
}'
