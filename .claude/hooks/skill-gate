#!/usr/bin/env bash
# Load the skills that cover a file before it is edited.
#
# Claude Code only auto-loads skill names and descriptions, not their bodies, so
# invoking the right one is left to the model's judgement -- which is how gsx
# markup or hk config gets hand-invented. This makes it the harness's job.
#
# Reads a PreToolUse payload on stdin; prints additionalContext when the file
# maps to one or more skills, nothing otherwise. Every skill it can serve lives
# in .claude/skills, so adding one is a word in the case below.
set -euo pipefail

payload=$(cat)
path=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty')
[ -n "$path" ] || exit 0

case "$path" in
  # Editing gsx markup needs both: gsx is the syntax, gsxui the components you
  # are meant to reach for instead of hand-rolling one.
  *.gsx)  skills="gsx gsxui" ;;
  *.pkl)  skills="hk-configure" ;;
  *)      exit 0 ;;
esac

context=""
for skill in $skills; do
  body=".claude/skills/$skill/SKILL.md"
  [ -f "$body" ] || continue
  context+="--- $skill ---"$'\n'"$(cat "$body")"$'\n\n'
done
[ -n "$context" ] || exit 0

jq -n --arg c "$context" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    additionalContext: ("These skills cover this file. Follow them rather than "
      + "inferring syntax or hand-writing components:\n\n" + $c)
  }
}'
