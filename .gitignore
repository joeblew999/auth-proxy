bin
/auth-proxy
# what a bare `go build` in a command directory leaves behind; dev build goes to bin/
/cmd/proxy/proxy
/cmd/gui/gui
/cmd/mock-upstream/mock-upstream
/cmd/bench/bench
/dist/
# a Worker's build output and wrangler's local state, next to its wrangler.toml
build/
.wrangler/
# the copy `dev worker deploy` runs wrangler on, so its id write-back lands there
wrangler.deploy.toml
# this clone's account facts, written by `dev url`
/mise.local.toml
# mise packslip skill links: each developer's `mise skills sync` creates these
# from the active tool versions. Never commit them; .claude/skills/ holds only
# the vendored copies from session.toml.
.claude/skills/.mise-skills.json
.claude/skills/dev
.claude/skills/gsx
.claude/skills/gsxui
.claude/skills/templ-to-gsx-migration
.claude/skills/hk-configure
.claude/skills/hk-debug
