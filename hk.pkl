amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// hk checks for auth-proxy. Only builtins whose executables come from
// this repo's mise toolchain (go) or are shell builtins. No actionlint,
// golangci-lint, or zizmor: none are pinned in mise.toml.
local linters = new Mapping {
    ["go_fmt"] = Builtins.go_fmt
    // cmd/gui embeds dist/, which exists only after its own build, so vetting
    // it here fails on a fresh clone; gui:check vets it after building.
    ["go_vet"] = (Builtins.go_vet) {
        exclude = List("cmd/gui/**")
    }
    ["gomod_tidy"] = Builtins.gomod_tidy
    // Vendored third-party skills are upstream content; never rewrite them.
    ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
        exclude = List(".claude/skills/**")
    }
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["detect_private_key"] = Builtins.detect_private_key
    ["check_added_large_files"] = Builtins.check_added_large_files
}

// The linters run on commit and on demand. `hk run check` is also what the
// Claude Code Stop hook runs after every agent turn, so it must stay cheap:
// nothing needing a login or the network belongs in it.
hooks {
    ["pre-commit"] { steps = linters }
    ["check"] { steps = linters }
    ["fix"] { steps = linters }

    // No pre-push hook. `session:verify` ran here: it starts a real Claude
    // Code session and holds it against SESSION.lock, so every push waited on
    // a login and a model, and ordinary changes failed it — bumping a pin
    // moves a skill, and the lock calls that drift. Run it by hand when the
    // session is the thing you are working on: `mise run session:verify`,
    // `mise run session:mcp`.
}
