#!/usr/bin/env bash
#MISE description="Run the proxy locally on http://127.0.0.1:56121/v1 (--mock: against the bundled mock, no real keys)"
#MISE depends=["build:cli"]
#MISE raw=true
#USAGE flag "--mock" help="Serve tools/mock-upstream/providers.toml (needs the mock daemon: mise run svc:start --mock)"
set -euo pipefail
if [ "${usage_mock:-false}" = "true" ]; then
  MOCK_API_KEY=mock-key fnox exec -- bin/grok-oauth-proxy serve --config tools/mock-upstream/providers.toml
else
  fnox exec -- bin/grok-oauth-proxy serve
fi
