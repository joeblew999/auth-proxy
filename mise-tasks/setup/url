#!/usr/bin/env bash
#MISE description="Compute this clone's deployed Worker URLs from the Cloudflare account in fnox, into gitignored mise.local.toml"
set -euo pipefail
name=$(sed -n 's/^name = "\([^"]*\)".*/\1/p' wrangler.toml | head -1)
[ -n "$name" ] || { echo "wrangler.toml has no name; add one"; exit 1; }
for v in CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN; do
  fnox get "$v" >/dev/null 2>&1 || { echo "$v is not in fnox; store it with: fnox set -g $v"; exit 1; }
done
# The account's workers.dev subdomain is the one thing the URL needs that no
# committed file may hold.
sub=$(fnox exec -- sh -c 'curl -sf -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/subdomain"' \
  | sed -n 's/.*"subdomain": *"\([^"]*\)".*/\1/p')
[ -n "$sub" ] || { echo "could not read the account's workers.dev subdomain: check CLOUDFLARE_API_TOKEN can read Workers, then: mise run setup:url"; exit 1; }
cat > mise.local.toml <<TOML
# Written by \`mise run setup:url\` for the Cloudflare account in fnox. Gitignored;
# run it again after switching accounts.
[env]
PROXY_URL = "https://$name.$sub.workers.dev"
PROXY_URL_TINYGO = "https://$name-tinygo.$sub.workers.dev"
TOML
echo "Worker URLs for this clone written to mise.local.toml:"
echo "  https://$name.$sub.workers.dev  (and -tinygo)"
