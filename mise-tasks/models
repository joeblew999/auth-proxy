#!/usr/bin/env bash
#MISE description="List model IDs across all providers (--worker: from the deployed Worker; otherwise needs mise run dev)"
#MISE depends=["build:cli"]
#USAGE flag "--worker" help="Ask the deployed Worker"
url=http://127.0.0.1:56121; [ "${usage_worker:-false}" = "true" ] && url="$PROXY_URL"
exec fnox exec -- bin/grok-oauth-proxy models --url "$url"
