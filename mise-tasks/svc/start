#!/usr/bin/env bash
#MISE description="Build and start the proxy as a pitchfork daemon (--mock: with the mock upstream)"
#MISE depends=["build:cli"]
#MISE raw=true
#USAGE flag "--mock" help="Start proxy-mock + mock instead of proxy"
set -euo pipefail
if [ "${usage_mock:-false}" = "true" ]; then
  go build -o bin/mock-upstream ./tools/mock-upstream
  exec pitchfork start proxy-mock
fi
exec pitchfork start proxy
