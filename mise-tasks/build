#!/usr/bin/env bash
#MISE description="Build the local binary (bin/) and the Worker (build/go); --tinygo also builds the TinyGo Worker and compares sizes"
#USAGE flag "--tinygo" help="Also build build/tinygo and print both sizes"
set -euo pipefail
go build -o bin/grok-oauth-proxy ./cmd/server
mise run build:worker
if [ "${usage_tinygo:-false}" = "true" ]; then
  mise run build:worker-tinygo
  for f in build/*/app.wasm; do
    printf '%-24s raw %6s KB   gzip %6s KB\n' "$f" $(( $(wc -c < "$f") / 1024 )) $(( $(gzip -9 -c "$f" | wc -c) / 1024 ))
  done
fi
