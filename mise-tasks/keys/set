#!/usr/bin/env bash
#MISE description="Store a provider's API key in fnox and push it to the Worker (admin: the client key)"
#MISE depends=["build:cli"]
#MISE raw=true
#USAGE arg "<provider>" help="Provider name from providers.toml, or admin for the proxy's client key"
#USAGE flag "--generate" help="Generate a random value instead of prompting (for admin)"
set -euo pipefail
name=$(bin/grok-oauth-proxy keys "$usage_provider")
if [ "${usage_generate:-false}" = "true" ]; then
  value=$(openssl rand -hex 32)
else
  [ -t 0 ] && printf 'Value for %s (input hidden): ' "$name"
  IFS= read -rs value || true
  [ -t 0 ] && echo
fi
if [ -z "$value" ]; then
  echo "No value given for $name; nothing was changed." >&2
  exit 1
fi
printf %s "$value" | fnox set -g "$name" >/dev/null
unset value
echo "Stored $name in fnox."
fnox exec -- sh -c 'printf %s "$(printenv "$1")" | wrangler secret put "$1" --env ""' _ "$name" >/dev/null
echo "Pushed $name to the Worker. Check with: mise run status --worker"
