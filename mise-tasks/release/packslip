#!/usr/bin/env bash
#MISE description="Build the packslip manifest for the local snapshot artifacts and verify it (no signing identity locally, so --no-log)"
set -euo pipefail
mise run release:snapshot >/dev/null
version=$(git describe --tags --always --dirty | sed 's/^v//')
key=${RUNNER_TEMP:-/tmp}/packslip-test.key
rm -f "$key" "$key.pub" "$key.b64"
packslip keygen --out "$key"
slug=$(git remote get-url origin | sed -E 's#.*github.com[:/]([^/]+/[^/]+)(\.git)?$#\1#;s#\.git$##')
packslip create --project "github.com/$slug" --version "$version" \
  --key "$key" --no-log --out dist \
  --bin grok-oauth-proxy \
  --resource 'skill/grok-oauth-proxy=repo:skills/grok-oauth-proxy' \
  --source-repo "https://github.com/$slug" \
  --commit "$(git rev-parse HEAD)" --tag "$(git describe --tags --always)" \
  dist/*.tar.gz
tail -1 "${key%.key}.pub" > "${key}.b64"
packslip verify dist/packslip.sigstore.json --pubkey "${key}.b64" --allow-unlogged \
  --artifact "$(ls dist/*.tar.gz | head -1)"
packslip show dist/packslip.sigstore.json | head -30
