#!/usr/bin/env bash
#MISE description="Send a prompt to a model and stream the answer (--worker: through the deployed Worker)"
#MISE depends=["build:cli"]
#USAGE arg "<model>" help="Model ID such as xai/grok-4.3; see: mise run models"
#USAGE arg "[prompt]" default="Say hello in one sentence."
#USAGE flag "--worker" help="Go through the deployed Worker instead of mise run dev"
url=http://127.0.0.1:56121
if [ "${usage_worker:-false}" = "true" ]; then
  [ -n "${PROXY_URL:-}" ] || { echo "PROXY_URL is not set for this clone; compute it with: mise run setup:url"; exit 1; }
  url="$PROXY_URL"
fi
exec fnox exec -- bin/grok-oauth-proxy chat --url "$url" "$usage_model" "$usage_prompt"
